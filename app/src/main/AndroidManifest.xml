<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground app detection, fallback path (user grants in Settings > Usage access). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Block screen launch from background for the UsageStats path (BAL exemption). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 16+: detect Advanced Protection Mode (Android 17 AAPM revokes non-tool accessibility). -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- App picker: every launchable app, without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SavvyApp"
        android:label="Savvy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Savvy"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Card screen. Also receives card taps:
             App Link (https card URL) from the NFC tag dispatch or the Camera app.
             Runs in Savvy's own task (no separate taskAffinity): its own task showed up as a
             second Savvy in Recents when opened from the block layer over a blocked app. -->
        <activity
            android:name=".block.BlockActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="true">
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="go.savvy.test" android:pathPrefix="/c/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="go.savvy.test" android:pathPrefix="/c/" />
            </intent-filter>
        </activity>

        <!-- ZXing's scanner activity ships locked to sensorLandscape; force portrait. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <!-- Approach B: AccessibilityService (primary). isAccessibilityTool=false in config. -->
        <service
            android:name=".service.SavvyAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>

        <!-- Approach A + D: UsageStats polling in a foreground service (fallback). -->
        <service
            android:name=".service.UsageMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started focus session active and blocks the apps the user chose until the session ends." />
        </service>

        <!-- directBootAware: LOCKED_BOOT_COMPLETED records the boot wall clock before the first
             unlock (offline reboot + clock-change protection, core TimeIntegrity). -->
        <receiver android:name=".service.BootReceiver" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Clock changed: checkpoint the running commitment with the monotonic clock. -->
        <receiver android:name=".service.TimeChangeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Periodic housekeeping and child rule sync independent of the focus FGS. -->
        <service
            android:name=".service.SyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Approach E: device admin. PARENT mode only (see STORE_POLICY_RISKS.md). -->
        <receiver
            android:name=".admin.SavvyDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Play "isMonitoringTool": required for child monitoring apps. Only in the parent-mode
             build if Savvy sends child data to the parent (see STORE_POLICY_RISKS.md). -->
        <!-- <meta-data android:name="isMonitoringTool" android:value="child_monitoring" /> -->
    </application>
</manifest>
